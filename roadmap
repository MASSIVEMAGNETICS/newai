from src.koopman.koopman_model import KoopmanQuantumModel
import numpy as np

# Define the oracle for Grover's algorithm
def oracle(state):
    # Mark the target state (e.g., |110>)
    target = np.zeros(8)
    target[6] = 1  # |110> is the 6th state in 3 qubits
    return state - 2 * np.dot(state, target) * target

# Initialize the Koopman model
model = KoopmanQuantumModel(num_qubits=3)

# Simulate Grover iteration
