import numpy as np
import networkx as nx

def build_quantum_graph(states, threshold=0.5):
    """Build a graph from quantum states (e.g., qubit configurations)."""
    G = nx.Graph()
    for i, state in enumerate(states):
        G.add_node(i, state=state)
    # Add edges based on state similarity
    for i in range(len(states)):
        for j in range(i+1, len(states)):
            sim = np.dot(states[i], states[j])
            if sim > threshold:
                G.add_edge(i, j, weight=sim)
    return G

def laplacian_smoothing(G, alpha=0.5):
    """Smooth node features using the graph Laplacian."""
    L = nx.laplacian_matrix(G).toarray()
    D = np.diag([1/np.sqrt(d) for d in G.degree()])
    L_sym = D @ L @ D
    features = np.array([G.nodes[i]['state'] for i in G.nodes])
    smoothed = features - alpha * L_sym @ features
    return smoothed


