import tensorflow as tf

class NaturalGradientOptimizer(tf.keras.optimizers.Optimizer):
    def __init__(self, learning_rate=0.01, name='NaturalGradient', **kwargs):
        super().__init__(name, **kwargs)
        self._set_hyper('learning_rate', learning_rate)

    def _resource_apply_dense(self, grad, var, apply_state=None):
        lr = tf.cast(self._get_hyper('learning_rate'), var.dtype)
        # Approximate Fisher matrix as outer product of gradients
        fisher = tf.matmul(tf.expand_dims(grad, 1), tf.expand_dims(grad, 0))
        # Natural gradient update
        update = tf.linalg.solve(fisher + 1e-6 * tf.eye(tf.shape(var)[0]), grad)
        var.assign_sub(lr * update)


